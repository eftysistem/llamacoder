import { useState } from 'react'
import { Button } from "/components/ui/button"
import { Card, CardContent, CardHeader, CardTitle } from "/components/ui/card"
import { Input } from "/components/ui/input"
import { Label } from "/components/ui/label"
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "/components/ui/select"
import { Textarea } from "/components/ui/textarea"
import { User, Mail, Phone, Calendar } from "lucide-react"

export default function ControlVisitaABAE() {
  const [formData, setFormData] = useState({
    nombre: '',
    email: '',
    telefono: '',
    personaVisita: '',
    departamento: '',
    motivo: '',
    fecha: new Date().toISOString().split('T')[0]
  })

  const [errors, setErrors] = useState({
    nombre: '',
    email: '',
    telefono: '',
    departamento: '',
    motivo: ''
  })

  const [submitted, setSubmitted] = useState(false)

  const departamentos = [
    "Dirección General",
    "Administración",
    "Recursos Humanos",
    "Finanzas",
    "Marketing",
    "Operaciones",
    "Tecnología"
  ]

  const validateForm = () => {
    let valid = true
    const newErrors = {
      nombre: '',
      email: '',
      telefono: '',
      departamento: '',
      motivo: ''
    }

    if (!formData.nombre.trim()) {
      newErrors.nombre = 'Nombre y apellido son requeridos'
      valid = false
    }

    if (!formData.email.trim()) {
      newErrors.email = 'Email es requerido'
      valid = false
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(formData.email)) {
      newErrors.email = 'Email no válido'
      valid = false
    }

    if (!formData.telefono.trim()) {
      newErrors.telefono = 'Teléfono es requerido'
      valid = false
    } else if (!/^[0-9]{7,15}$/.test(formData.telefono)) {
      newErrors.telefono = 'Teléfono no válido'
      valid = false
    }

    if (!formData.departamento) {
      newErrors.departamento = 'Departamento es requerido'
      valid = false
    }

    if (!formData.motivo.trim()) {
      newErrors.motivo = 'Motivo de visita es requerido'
      valid = false
    }

    setErrors(newErrors)
    return valid
  }

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {
    const { name, value } = e.target
    setFormData({
      ...formData,
      [name]: value
    })
  }

  const handleSelectChange = (value: string) => {
    setFormData({
      ...formData,
      departamento: value
    })
  }

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault()
    if (validateForm()) {
      setSubmitted(true)
      // Here you would typically send the data to an API
      console.log('Form submitted:', formData)
    }
  }

  const resetForm = () => {
    setFormData({
      nombre: '',
      email: '',
      telefono: '',
      personaVisita: '',
      departamento: '',
      motivo: '',
      fecha: new Date().toISOString().split('T')[0]
    })
    setErrors({
      nombre: '',
      email: '',
      telefono: '',
      departamento: '',
      motivo: ''
    })
    setSubmitted(false)
  }

  return (
    <div className="min-h-screen bg-gray-50 py-8 px-4">
      <Card className="max-w-2xl mx-auto">
        <CardHeader className="border-b">
          <div className="flex items-center justify-between">
            <CardTitle className="text-2xl">Control de Visita ABAE</CardTitle>
            <div className="bg-gray-200 border-2 border-dashed rounded-xl w-16 h-16" />
          </div>
        </CardHeader>

        <CardContent className="pt-6">
          {submitted ? (
            <div className="space-y-6">
              <div className="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">
                <p className="font-bold">¡Visita registrada exitosamente!</p>
                <p>Gracias por su visita a la ABAE.</p>
              </div>

              <div className="space-y-4">
                <h3 className="text-lg font-semibold">Resumen de la visita</h3>
                <div className="grid grid-cols-2 gap-4">
                  <div>
                    <p className="text-sm text-muted-foreground">Fecha</p>
                    <p>{formData.fecha}</p>
                  </div>
                  <div>
                    <p className="text-sm text-muted-foreground">Nombre</p>
                    <p>{formData.nombre}</p>
                  </div>
                  <div>
                    <p className="text-sm text-muted-foreground">Email</p>
                    <p>{formData.email}</p>
                  </div>
                  <div>
                    <p className="text-sm text-muted-foreground">Teléfono</p>
                    <p>{formData.telefono}</p>
                  </div>
                  <div>
                    <p className="text-sm text-muted-foreground">Persona a visitar</p>
                    <p>{formData.personaVisita || 'No especificado'}</p>
                  </div>
                  <div>
                    <p className="text-sm text-muted-foreground">Departamento</p>
                    <p>{formData.departamento}</p>
                  </div>
                </div>
                <div>
                  <p className="text-sm text-muted-foreground">Motivo de la visita</p>
                  <p className="whitespace-pre-line">{formData.motivo}</p>
                </div>
              </div>

              <Button onClick={resetForm} className="w-full">
                Registrar nueva visita
              </Button>
            </div>
          ) : (
            <form onSubmit={handleSubmit} className="space-y-6">
              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div className="space-y-2">
                  <Label htmlFor="fecha">Fecha</Label>
                  <div className="relative">
                    <Calendar className="absolute left-3 top-3 h-4 w-4 text-muted-foreground" />
                    <Input
                      id="fecha"
                      name="fecha"
                      type="date"
                      value={formData.fecha}
                      onChange={handleChange}
                      className="pl-10"
                    />
                  </div>
                </div>

                <div className="space-y-2">
                  <Label htmlFor="nombre">Nombre y Apellido *</Label>
                  <div className="relative">
                    <User className="absolute left-3 top-3 h-4 w-4 text-muted-foreground" />
                    <Input
                      id="nombre"
                      name="nombre"
                      value={formData.nombre}
                      onChange={handleChange}
                      placeholder="Ingrese su nombre completo"
                      className="pl-10"
                    />
                  </div>
                  {errors.nombre && <p className="text-sm text-red-500">{errors.nombre}</p>}
                </div>

                <div className="space-y-2">
                  <Label htmlFor="email">Correo Electrónico *</Label>
                  <div className="relative">
                    <Mail className="absolute left-3 top-3 h-4 w-4 text-muted-foreground" />
                    <Input
                      id="email"
                      name="email"
                      type="email"
                      value={formData.email}
                      onChange={handleChange}
                      placeholder="ejemplo@email.com"
                      className="pl-10"
                    />
                  </div>
                  {errors.email && <p className="text-sm text-red-500">{errors.email}</p>}
                </div>

                <div className="space-y-2">
                  <Label htmlFor="telefono">Teléfono *</Label>
                  <div className="relative">
                    <Phone className="absolute left-3 top-3 h-4 w-4 text-muted-foreground" />
                    <Input
                      id="telefono"
                      name="telefono"
                      type="tel"
                      value={formData.telefono}
                      onChange={handleChange}
                      placeholder="Ingrese su número de teléfono"
                      className="pl-10"
                    />
                  </div>
                  {errors.telefono && <p className="text-sm text-red-500">{errors.telefono}</p>}
                </div>

                <div className="space-y-2">
                  <Label htmlFor="personaVisita">Persona a quien visita</Label>
                  <Input
                    id="personaVisita"
                    name="personaVisita"
                    value={formData.personaVisita}
                    onChange={handleChange}
                    placeholder="Nombre de la persona a visitar"
                  />
                </div>

                <div className="space-y-2">
                  <Label htmlFor="departamento">Dirección de Departamento *</Label>
                  <Select onValueChange={handleSelectChange} value={formData.departamento}>
                    <SelectTrigger>
                      <SelectValue placeholder="Seleccione un departamento" />
                    </SelectTrigger>
                    <SelectContent>
                      {departamentos.map((depto) => (
                        <SelectItem key={depto} value={depto}>
                          {depto}
                        </SelectItem>
                      ))}
                    </SelectContent>
                  </Select>
                  {errors.departamento && <p className="text-sm text-red-500">{errors.departamento}</p>}
                </div>
              </div>

              <div className="space-y-2">
                <Label htmlFor="motivo">Motivo de la Visita *</Label>
                <Textarea
                  id="motivo"
                  name="motivo"
                  value={formData.motivo}
                  onChange={handleChange}
                  placeholder="Describa el motivo de su visita"
                  rows={4}
                />
                {errors.motivo && <p className="text-sm text-red-500">{errors.motivo}</p>}
              </div>

              <Button type="submit" className="w-full">
                Registrar Visita
              </Button>
            </form>
          )}
        </CardContent>
      </Card>
    </div>
  )
}
